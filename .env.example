# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e
# preencha com os valores reais antes de rodar `docker compose up -d --build`.
# O arquivo ".env" real NUNCA deve ir pro Git.

# Senha do Postgres do Fable.
POSTGRES_PASSWORD=postgres

# Chave que assina os tokens de login — gere uma string forte
# (ex: openssl rand -base64 48) e nunca reaproveite a de dev.
JWT_SECRET=

# Usuário admin criado automaticamente no primeiro boot (banco vazio).
ADMIN_EMAIL=admin@fable.local
ADMIN_SENHA=

# URL pública do backend, embutida no JS pelo Vite em tempo de build.
# Em produção (VPS): https://api.fable.amsx.online
VITE_API_URL=http://localhost:4002

# Porta do Postgres do Fable no host (só pra acesso de fora do Docker).
DB_PORT=5450
